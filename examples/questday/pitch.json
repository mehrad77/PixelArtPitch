      },
      {
        "id": "c02",
        "text": "QuestDay turns every task into a quest."
      },
      {
        "id": "c03",
        "text": "Clear tasks, collect stars, raise your flag."
      },
      {
        "id": "c04",
        "text": "QuestDay. Press start."
